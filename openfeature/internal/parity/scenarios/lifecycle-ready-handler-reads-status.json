      "initialize": "deferred"
    },
    "q": {
      "runsOn": "client"
    },
    "r": {
      "runsOn": "client",
      "initialize": "deferred"
    }
  },
  "steps": [
    {"op":"addHandler","target":"api","event":"PROVIDER_READY","handler":"hA","readStatus":"d"},
