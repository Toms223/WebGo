    "z": {
      "runsOn": "client",
      "onContextChange": "sync"
    },
    "m": {
      "runsOn": "client",
      "onContextChange": "sync"
    },
    "a": {
      "runsOn": "client",
      "onContextChange": "sync"
    }
  },
